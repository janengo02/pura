# Environment Configuration
# Valid values: development, production, test
# Default: development (if not specified)
NODE_ENV=development

# Server Configuration
# Port number for the server to listen on
# Must be a valid port number (1-65535)
# Default: 2000 (if not specified)
PORT=2000

# Database Configuration
# MongoDB connection string (required)
# Must start with mongodb:// or mongodb+srv://
# Example: mongodb://localhost:27017/pura or mongodb+srv://user:pass@cluster.mongodb.net/pura
DATABASE_URI=your_mongodb_database_connection_string

# Security Configuration
# JWT secret for signing tokens (required)
# Must be at least 32 characters long for security
# Generate with: openssl rand -base64 32
JWT_SECRET=your_secure_jwt_secret_key_at_least_32_characters_long

# Encryption key for Google OAuth tokens (required)
# Must be at least 32 characters long for security
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_secure_encryption_key_for_google_tokens_32_chars

# Google OAuth Configuration (required)
# Get these from Google Cloud Console
# Must be valid Google OAuth client credentials
GOOGLE_CLIENT_ID=your_google_client_id_from_google_cloud_console
GOOGLE_CLIENT_SECRET=your_google_client_secret_from_google_cloud_console

# Frontend Configuration
# URL where your frontend is hosted (required)
# Must be a valid URL format
# Used for CORS configuration
FRONTEND_URL=http://localhost:8080

# Sender email address (required for sending emails)
EMAIL_USER=your_email@gmail.com
# Email password or app-specific password (required)
# For Gmail, use App Password instead of regular password
EMAIL_PASSWORD=your_email_app_password
# Admin email to receive test access requests (required)
ADMIN_EMAIL=admin@yourdomain.com