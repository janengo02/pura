# Google OAuth Configuration (required)
# Get this from Google Cloud Console
# Must match the client ID configured in your Google OAuth app
# Used for Google authentication on the frontend
REACT_APP_GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_from_google_cloud_console

# API Configuration (optional)
# URL where your backend API is hosted
# Must be a valid URL format if specified
# Default: http://localhost:2000 (if not specified)
REACT_APP_API_URL=http://localhost:2000